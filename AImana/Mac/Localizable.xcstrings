            "state": "translated",
            "value": "Estimativa equivalente à API, não o que seu plano cobra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation équivalente API, pas ce que facture votre forfait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-äquivalente Schätzung, nicht das, was dein Tarif abrechnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima equivalente all'API, non quanto addebita il tuo piano."
          }
        }
      }
    },

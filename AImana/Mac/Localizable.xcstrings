    "AImana": {
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana"
          }
        }
      }
    },
    "AImana reads Claude Code's official statusline data (5-hour and weekly limits, Pro/Max only). Install adds a small wrapper to ~/.claude/settings.json that saves those numbers and still runs your current statusline. A backup is kept and Uninstall restores the previous setting exactly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana reads Claude Code's official statusline data (5-hour and weekly limits, Pro/Max only). Install adds a small wrapper to ~/.claude/settings.json that saves those numbers and still runs your current statusline. A backup is kept and Uninstall restores the previous setting exactly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana lee los datos oficiales de la statusline de Claude Code (límites de 5 horas y semanal, solo Pro/Max). Instalar agrega un pequeño envoltorio en ~/.claude/settings.json que guarda esas cifras y sigue ejecutando tu statusline actual. Se guarda una copia de seguridad y Desinstalar restaura exactamente la configuración anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AI·mana lê os dados oficiais da statusline do Claude Code (limites de 5 horas e semanal, apenas Pro/Max). Instalar adiciona um pequeno wrapper em ~/.claude/settings.json que salva esses números e continua executando sua statusline atual. Um backup é mantido e Desinstalar restaura exatamente a configuração anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana lit les données officielles de la statusline de Claude Code (limites sur 5 heures et hebdomadaire, Pro/Max uniquement). Installer ajoute un petit script dans ~/.claude/settings.json qui enregistre ces chiffres et exécute toujours votre statusline actuelle. Une sauvegarde est conservée et Désinstaller restaure exactement le réglage précédent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana liest die offiziellen Statusline-Daten von Claude Code (5-Stunden- und Wochenlimit, nur Pro/Max). Installieren fügt in ~/.claude/settings.json einen kleinen Wrapper hinzu, der diese Werte speichert und deine bisherige Statusline weiter ausführt. Es wird ein Backup angelegt, und Deinstallieren stellt die vorherige Einstellung exakt wieder her."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AI·mana legge i dati ufficiali della statusline di Claude Code (limiti di 5 ore e settimanale, solo Pro/Max). Installa aggiunge un piccolo wrapper in ~/.claude/settings.json che salva questi valori e continua a eseguire la tua statusline attuale. Viene conservato un backup e Disinstalla ripristina esattamente l'impostazione precedente."
          }
        }
      }
    },
    "API-equivalent estimate, not what your plan bills.": {
      "localizations": {
        "en": {

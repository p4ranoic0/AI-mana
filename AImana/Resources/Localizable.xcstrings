    "Each provider appears on the dashboard once its key is saved. AI·mana reads only usage and balances through each provider's official API.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Anbieter erscheint im Dashboard, sobald sein Schlüssel gespeichert ist. AI·mana liest nur Nutzung und Guthaben über die offizielle API des jeweiligen Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each provider appears on the dashboard once its key is saved. AI·mana reads only usage and balances through each provider's official API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proveedor aparece en el panel cuando guardas su clave. AI·mana solo lee el uso y los saldos a través de la API oficial de cada proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fournisseur apparaît dans le tableau de bord dès que sa clé est enregistrée. AI·mana ne lit que l’utilisation et les soldes via l’API officielle de chaque fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni provider compare nella dashboard quando ne salvi la chiave. AI·mana legge solo utilizzo e saldi tramite l’API ufficiale di ciascun provider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada provedor aparece no painel quando a chave dele é salva. O AI·mana lê apenas uso e saldos pela API oficial de cada provedor."
          }
        }
      }
    },

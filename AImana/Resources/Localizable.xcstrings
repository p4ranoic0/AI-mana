    "Create a key at openrouter.ai/keys. AI·mana reads only its usage and limits through OpenRouter's official API. The key stays in the iOS Keychain on this iPhone.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Schlüssel unter openrouter.ai/keys. AI·mana liest nur Nutzung und Limits über die offizielle API von OpenRouter. Der Schlüssel bleibt im iOS-Schlüsselbund dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a key at openrouter.ai/keys. AI·mana reads only its usage and limits through OpenRouter's official API. The key stays in the iOS Keychain on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una clave en openrouter.ai/keys. AI·mana solo lee su uso y sus límites con la API oficial de OpenRouter. La clave queda en el llavero de iOS de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une clé sur openrouter.ai/keys. AI·mana lit seulement son utilisation et ses limites via l'API officielle d'OpenRouter. La clé reste dans le trousseau iOS de cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una chiave su openrouter.ai/keys. AI·mana legge solo utilizzo e limiti tramite l'API ufficiale di OpenRouter. La chiave resta nel portachiavi iOS di questo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma chave em openrouter.ai/keys. O AI·mana lê apenas o uso e os limites dela pela API oficial do OpenRouter. A chave fica nas Chaves do iOS neste iPhone."
          }
        }
      }
    },
    "Create a key at platform.deepseek.com/api_keys. AI·mana reads only your balance through DeepSeek's official API. The key stays in the iOS Keychain on this iPhone.": {

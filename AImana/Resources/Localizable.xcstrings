    "iOS decides how often AImana can refresh in the background, so alerts may arrive late. Opening the app checks right away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet, wie oft AI·mana im Hintergrund aktualisieren darf, daher können Hinweise verspätet ankommen. Beim Öffnen der App wird sofort geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides how often AI·mana can refresh in the background, so alerts may arrive late. Opening the app checks right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide cada cuánto AI·mana puede actualizarse en segundo plano, así que las alertas pueden llegar tarde. Al abrir la app se revisa al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide à quelle fréquence AI·mana peut s'actualiser en arrière-plan : les alertes peuvent donc arriver en retard. Ouvrir l'app vérifie immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide ogni quanto AI·mana può aggiornarsi in background, quindi gli avvisi possono arrivare in ritardo. Aprendo l'app il controllo è immediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS decide com que frequência o AI·mana pode atualizar em segundo plano, então os alertas podem chegar atrasados. Abrir o app verifica na hora."
          }
        }
      }
    },

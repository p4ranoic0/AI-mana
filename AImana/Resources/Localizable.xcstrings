        }
      }
    },
    "GitHub did not accept this token. It needs the Plan account permission (read-only).": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat diesen Token nicht akzeptiert. Er braucht die Kontoberechtigung „Plan“ (nur lesen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub did not accept this token. It needs the Plan account permission (read-only)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no aceptó este token. Necesita el permiso de cuenta Plan (solo lectura)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas accepté ce jeton. Il lui faut l’autorisation de compte Plan (lecture seule)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha accettato questo token. Serve l’autorizzazione dell’account Plan (sola lettura)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não aceitou este token. Ele precisa da permissão de conta Plan (somente leitura)."
          }
        }
      }
    },
    "GitHub has no Copilot usage report for this account. A seat paid by an organization (Copilot Business or Enterprise) is not in your personal report.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat für dieses Konto keinen Copilot-Nutzungsbericht. Eine von einer Organisation bezahlte Lizenz (Copilot Business oder Enterprise) steht nicht in deinem persönlichen Bericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub has no Copilot usage report for this account. A seat paid by an organization (Copilot Business or Enterprise) is not in your personal report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no tiene un informe de uso de Copilot para esta cuenta. Una licencia pagada por una organización (Copilot Business o Enterprise) no aparece en tu informe personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas de rapport d’utilisation Copilot pour ce compte. Une licence payée par une organisation (Copilot Business ou Enterprise) n’apparaît pas dans votre rapport personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha un report di utilizzo di Copilot per questo account. Una licenza pagata da un’organizzazione (Copilot Business o Enterprise) non compare nel tuo report personale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não tem um relatório de uso do Copilot para esta conta. Uma licença paga por uma organização (Copilot Business ou Enterprise) não aparece no seu relatório pessoal."
          }
        }
      }
    },
    "GitHub's API reports what you spend, not your allowance, so AI·mana measures it against this plan. Included credits reset on the 1st of each month at 00:00 UTC. A seat paid by an organization is not in your personal report.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GitHub-API meldet, was du ausgibst, nicht dein Kontingent – AI·mana misst es daher an diesem Tarif. Enthaltene Credits werden am 1. jedes Monats um 00:00 UTC zurückgesetzt. Eine von einer Organisation bezahlte Lizenz steht nicht in deinem persönlichen Bericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub's API reports what you spend, not your allowance, so AI·mana measures it against this plan. Included credits reset on the 1st of each month at 00:00 UTC. A seat paid by an organization is not in your personal report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La API de GitHub informa lo que gastas, no lo que tienes incluido, así que AI·mana lo compara con este plan. Los créditos incluidos se reinician el día 1 de cada mes a las 00:00 UTC. Una licencia pagada por una organización no aparece en tu informe personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’API de GitHub indique vos dépenses, pas votre allocation : AI·mana les compare donc à ce forfait. Les crédits inclus se réinitialisent le 1er de chaque mois à 00:00 UTC. Une licence payée par une organisation n’apparaît pas dans votre rapport personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’API di GitHub riporta quanto spendi, non quanto hai incluso, quindi AI·mana lo confronta con questo piano. I crediti inclusi si azzerano il 1° di ogni mese alle 00:00 UTC. Una licenza pagata da un’organizzazione non compare nel tuo report personale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A API do GitHub informa quanto você gasta, não o que está incluído, então o AI·mana compara com este plano. Os créditos incluídos reiniciam no dia 1 de cada mês às 00:00 UTC. Uma licença paga por uma organização não aparece no seu relatório pessoal."
          }
        }
      }
    },

    "A reading is recorded each time AImana refreshes, and every few minutes by the Mac relay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jeder Aktualisierung von AI·mana wird ein Messwert gespeichert, und alle paar Minuten vom Mac-Relay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading is recorded each time AI·mana refreshes, and every few minutes by the Mac relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
